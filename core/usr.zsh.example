# Fill in your own configurations here. All configurations defined here will override system presets.
# Copy this file to usr.zsh to customize: cp usr.zsh.example usr.zsh

# Language setting (en or zh). Defaults to system locale detection if not set.
# export ZFL_LANG=en

# User custom alias examples:
# alias ls='eza --icons'
# alias c='clear'

# Network proxy configuration examples:
# export HTTPS_PROXY=http://127.0.0.1:7897
# export HTTP_PROXY=http://127.0.0.1:7897

# Environment variables & PATH examples:
# export PATH=$PATH:~/.local/bin


